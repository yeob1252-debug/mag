  "headers": [
    {
      "source": "/assets/ireolttaen-ai/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/ai-inquiry.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "matgamsa.com"
        }
      ],
      "destination": "https://www.aiforthis.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.matgamsa.com"
        }
      ],
      "destination": "https://www.aiforthis.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/resources.html",
      "destination": "/index.html?page=resources",
      "permanent": false
    },
    {
      "source": "/resource.html",
      "destination": "/index.html?page=resource",
      "permanent": false
    },
    {
      "source": "/class.html",
      "destination": "/index.html?page=classes",
